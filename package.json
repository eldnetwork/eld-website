{
  "name": "eld-website",
  "version": "1.0.0",
  "description": "Marketing site for the Eld decentralized ephemeral storage protocol",
  "homepage": "https://www.eld.network",
  "type": "module",
  "author": "Eld",
  "license": "MIT",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "ci": "npm run format:check && npm run lint && npm test && npm audit --omit=dev --audit-level=high && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "vite": "^5.0.8",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0"
  }
}
